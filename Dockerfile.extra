FROM alpine:3.24.3 AS alpine-minimal

LABEL maintainer="Kamran Azeem & Henrik Høegh (kamranazeem@gmail.com, henrikrhoegh@gmail.com)"


EXPOSE 80 443 1180 11443

# Install some tools in the container and generate self-signed SSL certificates.
# Packages are listed in alphabetical order, for ease of readability and ease of maintenance.
# hadolint ignore=DL3018
RUN     apk update \
    &&  apk add --no-cache \
                bash bind-tools busybox-extras curl \
                iproute2 iputils jq mtr \
                net-tools nginx openssh-client openssl \
                perl-net-telnet procps rsync tcpdump tcptraceroute wget \
    &&  rm -rf /var/cache/apk/* \
    &&  mkdir /certs /docker \
    &&  chmod 700 /certs \
    &&  openssl req \
        -x509 -newkey rsa:2048 -nodes -days 3650 \
        -keyout /certs/server.key -out /certs/server.crt -subj '/CN=localhost'


# Copy a simple index.html to eliminate text (index.html) noise which comes with default nginx image.
# (I created an issue for this purpose here: https://github.com/nginxinc/docker-nginx/issues/234)
COPY index.html /usr/share/nginx/html/

# Copy a custom/simple nginx.conf which contains directives
#   to redirected access_log and error_log to stdout and stderr.
# Note: Don't use '/etc/nginx/conf.d/' directory for nginx virtual hosts anymore.
#   This 'include' will be moved to the root context in Alpine 3.14.

COPY nginx.conf /etc/nginx/nginx.conf

COPY entrypoint.sh /docker/entrypoint.sh


# Add a healthcheck to the Dockerfile.
# This file does not inherit the HEALTHCHECK from the minimal Dockerfile, so it
#   is defined here as well. The shell expands ${HTTP_PORT:-80} at run time.
# hadolint ignore=DL3025
HEALTHCHECK --interval=30s --timeout=3s CMD curl -fsS -m 2 http://localhost:${HTTP_PORT:-80}/ || exit 1


# Start nginx in foreground:
CMD ["/usr/sbin/nginx", "-g", "daemon off;"]


# Note: If you have not included the "bash" package under "apk add" command above,
#         then it is "mandatory" to add "/bin/sh" in the ENTRYPOINT instruction.
#       Otherwise you will get strange errors when you try to run the container.
#       Such as:
#       standard_init_linux.go:219: exec user process caused: no such file or directory

# Run the startup script as ENTRYPOINT, which does few things and then starts nginx.
ENTRYPOINT ["/bin/sh", "/docker/entrypoint.sh"]


FROM alpine-minimal
# hadolint ignore=DL3018
RUN  apk add --no-cache \
        apache2-utils ethtool git iperf3 lftp mysql-client mtr \
        netcat-openbsd net-snmp-tools nmap nmap-scripts \
        postgresql-client samba-client socat tshark \
    &&  rm -rf /var/cache/apk/*



###################################################################################################

# Build and Push (to dockerhub) instructions:
# -------------------------------------------
# docker build -f Dockerfile.extra -t local/network-multitool:extra .
# docker tag local/network-multitool:extra wbitt/network-multitool:extra
# docker login
# docker push wbitt/network-multitool:extra


# Pull (from dockerhub):
# ----------------------
# docker pull wbitt/network-multitool:extra


# Usage - on Docker:
# ------------------
# docker run --rm -it wbitt/network-multitool:extra /bin/bash
# OR
# docker run -d  wbitt/network-multitool:extra
# OR
# docker run -p 80:80 -p 443:443 -d  wbitt/network-multitool:extra
# OR
# docker run -e HTTP_PORT=1080 -e HTTPS_PORT=1443 -p 1080:1080 -p 1443:1443 -d  wbitt/network-multitool:extra


# Usage - on Kubernetes:
# ---------------------
# kubectl run multitool --image=wbitt/network-multitool:extra --replicas=1
